{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run SurgiFlow Twin",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/prototype-python/src/main.py",
      "cwd": "${workspaceFolder}/prototype-python",
      "console": "integratedTerminal"
    },
    {
      "name": "Self-test (autopilot + screenshots)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/prototype-python/src/main.py",
      "args": ["--selftest"],
      "cwd": "${workspaceFolder}/prototype-python",
      "console": "integratedTerminal"
    }
  ]
}

